# --- Groq API (رایگان) ---
# کلید را از https://console.groq.com/keys بگیرید (نیاز به ثبت‌نام رایگان دارد)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# فاصله زمانی هر چرخه بررسی Agent بر حسب ثانیه.
# پلن رایگان Groq سقف توکن روزانه محدودی دارد (برای llama-3.3-70b معمولاً 100000 توکن/روز)
# با فاصله 60 ثانیه این سقف در کمتر از یک ساعت پر می‌شود.
# برای تست/دمو مقدار 300 تا 600 (هر 5 تا 10 دقیقه) پیشنهاد می‌شود.
AGENT_POLL_INTERVAL_SECONDS=300

# --- InfluxDB ---
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=devtoken12345
INFLUXDB_ORG=net-agent
INFLUXDB_BUCKET=network-metrics

# --- SNMP ---
SNMP_COMMUNITY=public
SNMP_TARGETS=192.168.1.1,192.168.1.2,192.168.1.10

# --- Guardrail engine ---
GUARDRAIL_URL=http://guardrail:8000
GUARDRAIL_MODE=observe   # observe | act (act اجازه اجرای واقعی اکشن‌ها را می‌دهد)

# --- Notifier ---
NOTIFIER_URL=http://notifier:8001

# --- Telegram notifier ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
